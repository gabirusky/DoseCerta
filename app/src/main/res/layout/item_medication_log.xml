<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/ui_card_gap" style="@style/Widget.DoseCerta.CardView.Compact">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="top">
        <ImageView android:id="@+id/image_status_icon" android:layout_width="32dp" android:layout_height="32dp" android:padding="6dp" android:background="@drawable/content_icon_background"
            android:src="@drawable/ic_pill" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/text_medication_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DoseCerta.Title" />
            <LinearLayout android:id="@+id/log_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                <TextView android:id="@+id/text_date_time" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="8dp"
                    android:textAppearance="@style/TextAppearance.DoseCerta.Body" android:textSize="13sp" />
                <TextView android:id="@+id/text_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/status_badge_taken" android:paddingHorizontal="10dp" android:paddingVertical="4dp"
                    android:text="@string/history_taken" android:textColor="@color/ui_success" android:textAppearance="@style/TextAppearance.DoseCerta.Label" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
