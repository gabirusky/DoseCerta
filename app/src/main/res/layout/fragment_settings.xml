<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="?android:attr/colorBackground" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingHorizontal="@dimen/ui_page_padding" android:paddingTop="@dimen/ui_page_top" android:paddingBottom="@dimen/ui_page_bottom">
        <TextView android:id="@+id/text_settings_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_title" android:textAppearance="@style/TextAppearance.DoseCerta.Headline" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/design_settings_subtitle" android:textAppearance="@style/TextAppearance.DoseCerta.Body" />
        <com.google.android.material.card.MaterialCardView app:cardCornerRadius="22dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/ui_content_padding">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_language" android:textAppearance="@style/TextAppearance.DoseCerta.Title" />
                <RadioGroup android:orientation="horizontal" android:id="@+id/radio_group_language" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/radio_portuguese" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:text="@string/design_language_portuguese" android:checked="true" android:textSize="14sp" android:buttonTint="?attr/colorPrimary" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/radio_english" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:text="@string/settings_language_english" android:textSize="14sp" android:buttonTint="?attr/colorPrimary" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="12dp"
            android:text="@string/design_reminders" android:textAppearance="@style/TextAppearance.DoseCerta.Section" android:accessibilityHeading="true" />
        <com.google.android.material.card.MaterialCardView app:cardCornerRadius="22dp" android:id="@+id/card_alarm_sound" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ui_card_gap" android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="@dimen/ui_content_padding">
                <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:src="@drawable/ic_notifications"
                    android:background="@drawable/ui_icon_container" app:tint="?attr/colorPrimary" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_alarm_sound" android:textAppearance="@style/TextAppearance.DoseCerta.Title" />
                    <TextView android:id="@+id/text_current_alarm_sound" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="@string/settings_alarm_sound_default" android:textAppearance="@style/TextAppearance.DoseCerta.Body" />
                </LinearLayout>
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_chevron_right" app:tint="?attr/colorOnSurfaceVariant" android:importantForAccessibility="no" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView app:cardCornerRadius="22dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/ui_card_gap">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/ui_content_padding">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_missed_reminder" android:textAppearance="@style/TextAppearance.DoseCerta.Title" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="@string/settings_missed_reminder_subtitle" android:textAppearance="@style/TextAppearance.DoseCerta.Body" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <com.google.android.material.slider.Slider android:id="@+id/slider_missed_reminder_hours" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:valueFrom="1" android:valueTo="10" android:stepSize="1" android:value="2" android:contentDescription="@string/reminder_followup_delay" />
                    <TextView android:id="@+id/text_missed_reminder_hours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
                        android:text="@string/reminder_hours_default" android:textAppearance="@style/TextAppearance.DoseCerta.Title" android:textColor="?attr/colorPrimary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView app:cardCornerRadius="22dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/ui_content_padding">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reminder_settings_title" android:textAppearance="@style/TextAppearance.DoseCerta.Title" />
                <TextView android:id="@+id/text_reminder_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:background="@drawable/ui_form_section_tonal" android:padding="16dp" android:textAppearance="@style/TextAppearance.DoseCerta.Body" android:textColor="?attr/colorOnPrimaryContainer" android:lineSpacingExtra="5dp" android:accessibilityLiveRegion="polite" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_notifications_settings" style="@style/Widget.DoseCerta.Button.Outlined"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/reminder_notifications_settings" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_exact_settings" style="@style/Widget.DoseCerta.Button.Outlined"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reminder_exact_settings" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_full_screen_settings" style="@style/Widget.DoseCerta.Button.Outlined"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reminder_full_screen_settings" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_diagnostics" style="@style/Widget.DoseCerta.Button.Text"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reminder_diagnostics" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="12dp"
            android:text="@string/design_privacy" android:textAppearance="@style/TextAppearance.DoseCerta.Section" android:accessibilityHeading="true" />
        <com.google.android.material.card.MaterialCardView app:cardCornerRadius="22dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/ui_card_gap">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/ui_content_padding">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_lock_details" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:text="@string/reminder_show_medication_on_lock" android:textSize="16sp" android:paddingEnd="8dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="@string/reminder_lock_privacy_explanation" android:textAppearance="@style/TextAppearance.DoseCerta.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView app:cardCornerRadius="22dp" android:id="@+id/card_privacy_policy" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ui_card_gap" android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="@dimen/ui_content_padding">
                <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:src="@drawable/ic_shield_privacy"
                    android:background="@drawable/ui_icon_container" app:tint="?attr/colorPrimary" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_privacy_policy" android:textAppearance="@style/TextAppearance.DoseCerta.Title" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="@string/settings_privacy_policy_subtitle" android:textAppearance="@style/TextAppearance.DoseCerta.Body" />
                </LinearLayout>
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_chevron_right" app:tint="?attr/colorOnSurfaceVariant" android:importantForAccessibility="no" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp" android:padding="@dimen/ui_content_padding" android:background="@drawable/ui_form_section_tonal">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_about" android:textAppearance="@style/TextAppearance.DoseCerta.Title" />
            <TextView android:id="@+id/text_app_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="@string/settings_version" android:textAppearance="@style/TextAppearance.DoseCerta.Body" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="@string/ui_medical_disclaimer" android:textAppearance="@style/TextAppearance.DoseCerta.Body" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
