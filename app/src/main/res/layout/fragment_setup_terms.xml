<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="?android:attr/colorBackground" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/ui_page_padding" android:paddingEnd="@dimen/ui_page_padding" android:paddingTop="@dimen/ui_page_top" android:paddingBottom="@dimen/ui_page_bottom">
        <ImageView android:layout_width="56dp" android:layout_height="56dp" android:padding="14dp" android:src="@drawable/ic_pill"
            android:background="@drawable/ui_icon_container" app:tint="?attr/colorPrimary" android:importantForAccessibility="no" />
        <TextView android:id="@+id/text_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="12dp"
            android:text="@string/ui_setup_summary" android:textAppearance="@style/TextAppearance.DoseCerta.Headline" android:accessibilityHeading="true" />
        <TextView android:id="@+id/text_disclaimer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp"
            android:text="@string/ui_medical_disclaimer" android:textAppearance="@style/TextAppearance.DoseCerta.Body" android:lineSpacingExtra="3dp" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" app:cardCornerRadius="22dp">
            <TextView android:id="@+id/text_privacy_policy" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/ui_content_padding"
                android:text="@string/ui_privacy_text" android:textAppearance="@style/TextAppearance.DoseCerta.Body" android:lineSpacingExtra="3dp" />
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/checkbox_accept" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:text="@string/setup_terms_checkbox" android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_continue" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/setup_terms_button" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
