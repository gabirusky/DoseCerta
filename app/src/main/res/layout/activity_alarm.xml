<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#99000000" android:padding="@dimen/ui_page_padding">
    <androidx.core.widget.NestedScrollView android:id="@+id/alarm_scroll" android:layout_width="0dp" android:layout_height="0dp"
        android:fillViewport="true" android:clipToPadding="false" app:layout_constraintWidth_max="600dp" app:layout_constraintHeight_max="1000dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical" android:paddingVertical="12dp">
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="22dp" app:cardBackgroundColor="?attr/colorSurface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/ui_content_padding">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_notifications" android:background="@drawable/ui_icon_container" app:tint="?attr/colorPrimary" android:importantForAccessibility="no" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/reminder_private_title" android:textAppearance="@style/TextAppearance.DoseCerta.Title" />
                    </LinearLayout>
                    <TextView android:id="@+id/text_medication_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                        android:textAppearance="@style/TextAppearance.DoseCerta.Headline" android:accessibilityLiveRegion="polite" />
                    <TextView android:id="@+id/text_dosage_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:paddingHorizontal="14dp" android:paddingVertical="8dp" android:background="@drawable/ui_form_section_tonal" android:textColor="?attr/colorOnPrimaryContainer" android:textAppearance="@style/TextAppearance.DoseCerta.Title" />
                    <TextView android:id="@+id/text_scheduled_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.DoseCerta.Body" />
                    <TextView android:id="@+id/text_action_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/colorError" android:visibility="gone" android:accessibilityLiveRegion="assertive" android:layout_marginTop="12dp" />
                    <LinearLayout android:id="@+id/layout_identity_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <com.dosecerta.alarm.SwipeToConfirmView android:id="@+id/swipe_take" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:layout_marginTop="16dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/button_take" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/notification_action_take" android:layout_marginTop="8dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/button_skip" style="@style/Widget.DoseCerta.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/notification_action_skip" android:layout_marginTop="8dp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/button_snooze" style="@style/Widget.DoseCerta.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/reminder_snooze_ten" android:layout_marginTop="8dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/button_silence" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/reminder_silence_close" android:layout_marginTop="4dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/reminder_sound_limit" android:textAppearance="@style/TextAppearance.DoseCerta.Body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
