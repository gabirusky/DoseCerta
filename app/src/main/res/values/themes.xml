<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.DoseCerta" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ui_primary</item>
        <item name="colorOnPrimary">@color/ui_on_primary</item>
        <item name="colorPrimaryContainer">@color/ui_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ui_on_primary_container</item>
        <item name="colorSecondary">@color/ui_secondary</item>
        <item name="colorOnSecondary">@color/ui_on_primary</item>
        <item name="colorSecondaryContainer">@color/ui_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/ui_on_secondary_container</item>
        <item name="colorTertiary">@color/ui_tertiary</item>
        <item name="colorOnTertiary">@color/ui_on_primary</item>
        <item name="colorTertiaryContainer">@color/ui_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/ui_on_tertiary_container</item>
        <item name="colorError">@color/ui_error</item>
        <item name="colorOnError">@color/ui_on_error</item>
        <item name="colorErrorContainer">@color/ui_error_container</item>
        <item name="colorOnErrorContainer">@color/ui_on_error_container</item>
        <item name="android:colorBackground">@color/ui_background</item>
        <item name="android:windowBackground">@color/ui_background</item>
        <item name="colorOnBackground">@color/ui_on_surface</item>
        <item name="colorSurface">@color/ui_surface</item>
        <item name="colorOnSurface">@color/ui_on_surface</item>
        <item name="colorSurfaceVariant">@color/ui_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/ui_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/ui_surface</item>
        <item name="colorSurfaceContainerLow">@color/ui_background</item>
        <item name="colorSurfaceContainer">@color/ui_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/ui_surface_variant</item>
        <item name="colorSurfaceContainerHighest">@color/ui_surface_variant</item>
        <item name="colorSurfaceBright">@color/ui_surface</item>
        <item name="colorSurfaceDim">@color/ui_surface_container</item>
        <item name="colorOutline">@color/ui_outline</item>
        <item name="colorOutlineVariant">@color/ui_outline_variant</item>
        <item name="android:textColorPrimary">@color/ui_on_surface</item>
        <item name="android:textColorSecondary">@color/ui_on_surface_variant</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@color/ui_background</item>
        <item name="android:windowLightStatusBar">@bool/ui_light_system_bars</item>
        <item name="android:navigationBarColor">@color/ui_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/ui_light_system_bars</item>
        <item name="materialButtonStyle">@style/Widget.DoseCerta.Button</item>
        <item name="materialCardViewStyle">@style/Widget.DoseCerta.CardView</item>
        <item name="textInputStyle">@style/Widget.DoseCerta.TextInput</item>
        <item name="chipStyle">@style/Widget.DoseCerta.Chip</item>
        <item name="bottomNavigationStyle">@style/Widget.DoseCerta.BottomNavigation</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.DoseCerta.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.DoseCerta.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.DoseCerta.LargeComponent</item>
    </style>
    <style name="Theme.DoseCerta" parent="Base.Theme.DoseCerta" />
    <style name="Theme.DoseCerta.Transparent" parent="Theme.DoseCerta">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
    <style name="Widget.DoseCerta.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textAppearance">@style/TextAppearance.DoseCerta.Action</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <style name="Widget.DoseCerta.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textAppearance">@style/TextAppearance.DoseCerta.Action</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
    </style>
    <style name="Widget.DoseCerta.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textAppearance">@style/TextAppearance.DoseCerta.Action</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.DoseCerta.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textAppearance">@style/TextAppearance.DoseCerta.Action</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="iconTint">?attr/colorOnPrimaryContainer</item>
    </style>
    <style name="Widget.DoseCerta.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:padding">12dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Widget.DoseCerta.CardView" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.DoseCerta.CardView.Tonal" parent="Widget.DoseCerta.CardView">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.DoseCerta.CardView.Compact" parent="Widget.DoseCerta.CardView">
        <item name="cardCornerRadius">16dp</item>
    </style>
    <style name="Widget.DoseCerta.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="boxStrokeColor">@color/ui_input_stroke</item>
    </style>
    <style name="Widget.DoseCerta.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="boxStrokeColor">@color/ui_input_stroke</item>
    </style>
    <style name="Widget.DoseCerta.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="chipMinTouchTargetSize">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelLarge</item>
    </style>
    <style name="Widget.DoseCerta.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="tint">?attr/colorOnPrimaryContainer</item>
        <item name="elevation">3dp</item>
    </style>
    <style name="Widget.DoseCerta.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">64dp</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">8dp</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="elevation">0dp</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.DoseCerta.Navigation</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.DoseCerta.Navigation</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.DoseCerta.NavigationIndicator</item>
    </style>
    <style name="Widget.DoseCerta.NavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
    </style>
    <style name="ShapeAppearance.DoseCerta.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.DoseCerta.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/card_corner_radius</item>
    </style>
    <style name="ShapeAppearance.DoseCerta.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">24dp</item>
    </style>
    <style name="TextAppearance.DoseCerta.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.DoseCerta.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.DoseCerta.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.DoseCerta.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TextAppearance.DoseCerta.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="TextAppearance.DoseCerta.Action" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.DoseCerta.Navigation" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
