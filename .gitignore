# Local assistant worktrees contain independent copies of the project.
/.kilo/worktrees/

# QA transport archives duplicate extracted evidence; PDF fixtures are generated.
# Keep manifests, audit results, screenshots, videos and instrumentation results.
# Archives and exported cache files stay on disk but must be regenerated or
# archived separately when collecting the complete original QA bundle.
/docs/qa/runs/**/*.tar
/docs/qa/runs/**/cache/
# Routine logcat dumps are large; retain the crash cited by the QA report.
/docs/qa/runs/**/logcat.txt
!/docs/qa/runs/20261004T200607980630Z-safety/logcat.txt
/docs/evidence/**/*.tar
/docs/evidence/**/cache/

# Release documentation is source material, not a generated release directory.
!docs/release/
!docs/release/**
